#include <stdio.h>
#include <stdlib.h>
#include <limits.h>
int find(int parent[], int x) {
    if (parent[x] != x)
        parent[x] = find(parent, parent[x]);

    return parent[x];
}

void unionSet(int parent[], int a, int b) {
    a = find(parent, a);
    b = find(parent, b);

    if (a != b)
        parent[b] = a;
}

void kruskalMST(int **cost, int V) {

    int parent[V];

    for (int i = 0; i < V; i++)
        parent[i] = i;

    int edges = 0;
    int totalCost = 0;

    while (edges < V - 1) {

        int min = INT_MAX;
        int u = -1, v = -1;

        // Find minimum cost edge
        for (int i = 0; i < V; i++) {
            for (int j = i + 1; j < V; j++) {

                if (cost[i][j] != 9999 && cost[i][j] < min) {
                    min = cost[i][j];
                    u = i;
                    v = j;
                }
            }
        }

        if (u == -1)
            break;

        // Check for cycle
        if (find(parent, u) != find(parent, v)) {

            unionSet(parent, u, v);

            printf("Edge %d:(%d, %d) cost:%d\n",
                   edges, u, v, min);

            totalCost += min;
            edges++;
        }

        // Mark edge as processed
        cost[u][v] = 9999;
        cost[v][u] = 9999;
    }

    printf("Minimum cost= %d\n", totalCost);
}

int main() {
    int V;
    printf("No of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
